# Cat Commands
bed.going_to_bed={name} geht zu einem Bett {distance} Blöcke entfernt bei ({x}, {y}, {z})
bed.no_beds_found=Keine Katzenbetten innerhalb von {radius} Blöcken um Position ({x}, {y}, {z}) gefunden
bed.all_beds_occupied=Alle {count} Katzenbett(en) in der Nähe sind von anderen schlafenden Katzen belegt
follow.re_triggered.hint=Katze war bereits im Folge-Modus, Aktualisierung erzwungen!
follow.re_triggered={name} wurde neu zum Folgen aufgefordert
follow.success={name} folgt dir jetzt
name.success={name} wurde umbenannt: {newName}
play.success={name} spielt jetzt!
search.success={name} sucht!
sit.success={name} sitzt jetzt
sleep.success={name} schläft jetzt
wait.success={name} wartet jetzt
wander.success={name} wandert jetzt frei umher

# Error Messages
error.no_cat=Keine Katze in Sicht
error.no_position=Katzenposition kann nicht ermittelt werden
error.not_owned=Diese Katze hat keinen Besitzer
error.not_owner=Diese Katze gehört {owner}
