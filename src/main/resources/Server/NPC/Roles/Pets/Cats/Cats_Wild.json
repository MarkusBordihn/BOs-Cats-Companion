{
  "$Comment": "Wild cat role extending Template_Animal_Neutral with custom taming and cat-specific behaviors",
  "Type": "Variant",
  "Reference": "Template_Animal_Neutral",
  "Modify": {
    "Appearance": {
      "Compute": "Appearance"
    },
    "AttitudeGroup": "Critters",
    "MaxHealth": {
      "Compute": "MaxHealth"
    },
    "MaxSpeed": 6,
    "RunThreshold": 0.7,
    "ViewRange": 16,
    "ViewSector": 240,
    "HearingRange": 10,
    "AlertedRange": 18,
    "AlertedActionRange": 8,
    "AbsoluteDetectionRange": 3,
    "WanderRadius": 10,
    "LeashDistance": 25,
    "AttractiveItemSet": {
      "Compute": "AttractiveItems"
    },
    "AttractiveItemSetParticles": "Want_Food_Carrot",
    "WeightFollowItem": 80,
    "FollowItemPreDelay": [0.5, 1.5],
    "FollowItemAlways": false,
    "FollowItemTimeout": [30, 60],
    "DayTimePeriod": [6.01, 17.99],
    "DayTimeNapWeight": 3,
    "DayTimeNapTimeRange": [8, 15],
    "DayFlavorAnimation": "Stretch",
    "DayFlavorAnimationLength": [3, 5],
    "DropList": "Drop_Cats",
    "Timid": {
      "Compute": "Timid"
    },
    "IsMemory": true,
    "MemoriesNameOverride": "Cat",
    "NameTranslationKey": {
      "Compute": "NameTranslationKey"
    },
    "_InteractionVars": {
      "Melee_Start": {
        "Interactions": [
          {
            "$Comment": "Cat melee attack animation and timing configuration",
            "Parent": "NPC_Attack_Melee_Simple",
            "Effects": {
              "ItemPlayerAnimationsId": "Fox_Default",
              "ItemAnimationId": "Attack"
            },
            "RunTime": 0.25
          }
        ]
      },
      "Melee_Damage": {
        "Interactions": [
          {
            "$Comment": "Cat melee attack damage configuration",
            "Parent": "NPC_Attack_Melee_Damage",
            "DamageCalculator": {
              "Type": "Absolute",
              "BaseDamage": {
                "Physical": 5
              },
              "RandomPercentageModifier": 0.1
            }
          }
        ]
      }
    }
  },
  "Instructions": [
    {
      "$Comment": "Override Idle state to add cat-specific animations",
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": "Idle",
            "SubState": ".Default"
          },
          "Actions": [
            {
              "Type": "Random",
              "ExecuteFor": [15, 25],
              "Instructions": [
                {
                  "$Comment": "Stretching",
                  "Weight": 5,
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Stretch",
                      "Slot": "Action"
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [3, 5]
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                },
                {
                  "$Comment": "Lick and clean",
                  "Weight": 5,
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Lick",
                      "Slot": "Action"
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [2, 4]
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                },
                {
                  "$Comment": "Playful pouncing",
                  "Weight": 3,
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Swing_Left",
                      "Slot": "Action"
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [2, 4]
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                },
                {
                  "$Comment": "Searching and hunting",
                  "Weight": 8,
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Search",
                      "Slot": "Action"
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [4, 7]
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                },
                {
                  "$Comment": "Sit and observe",
                  "Weight": 7,
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Sit",
                      "Slot": "Action"
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [5, 10]
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Custom Feeding state for taming progression",
          "Sensor": {
            "Type": "State",
            "State": "Feeding"
          },
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Animation": "Sit",
              "Slot": "Action"
            },
            {
              "Type": "SpawnParticles",
              "ParticleSystem": "Food_Eat",
              "Range": 5,
              "Offset": [0, 0.5, 0]
            },
            {
              "Type": "Timeout",
              "Delay": 2
            },
            {
              "Type": "SpawnParticles",
              "ParticleSystem": "Hearts_Subtle",
              "Range": 5,
              "Offset": [0, 0.7, 0]
            },
            {
              "Type": "Timeout",
              "Delay": 1
            },
            {
              "Type": "State",
              "State": "Idle"
            }
          ],
          "BodyMotion": {
            "Type": "Nothing"
          }
        },
        {
          "$Comment": "Custom Rejection state when wrong item is used",
          "Sensor": {
            "Type": "State",
            "State": "Rejection"
          },
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Animation": "Alerted",
              "Slot": "Action"
            },
            {
              "Type": "SpawnParticles",
              "ParticleSystem": "Angry",
              "Range": 5,
              "Offset": [0, 0.7, 0]
            },
            {
              "Type": "Timeout",
              "Delay": 2
            },
            {
              "Type": "State",
              "State": "Idle"
            }
          ],
          "BodyMotion": {
            "Type": "Nothing"
          }
        },
        {
          "$Comment": "Custom Despawn state",
          "Sensor": {
            "Type": "State",
            "State": "Despawn"
          },
          "Actions": [
            {
              "Type": "Despawn"
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "$Comment": "Override default taming interaction with custom CatInteractionWild action - Wild cat always shows taming hint on mouse-over",
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "cats.interactions.hint.tame",
            "ShowPrompt": true
          }
        ]
      },
      {
        "$Comment": "Handle taming interaction with custom multi-fish progression system",
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Actions": [
          {
            "Type": "LockOnInteractionTarget"
          },
          {
            "Type": "CatInteractionWild"
          }
        ]
      }
    ]
  },
  "Parameters": {
    "MaxHealth": {
      "Value": 20,
      "Description": "Maximum health points for wild cats"
    },
    "AttractiveItems": {
      "Value": [
        "Food_Fish_Raw",
        "Food_Fish_Raw_Uncommon",
        "Food_Fish_Raw_Rare",
        "Food_Fish_Raw_Epic",
        "Food_Fish_Raw_Legendary",
        "Food_Fish_Grilled",
        "Fish_Salmon_Item",
        "Fish_Catfish_Item",
        "Fish_Trout_Rainbow_Item",
        "Fish_Pike_Item",
        "Fish_Bluegill_Item",
        "Fish_Minnow_Item"
      ],
      "Description": "Items that attract cats and make them follow players"
    },
    "Timid": {
      "Value": false,
      "Description": "Whether cats are timid and harder to approach"
    },
    "Appearance": {
      "Value": "Cat",
      "Description": "The cat's model appearance"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Cats_Wild.name",
      "Description": "Translation key for cat name display"
    },
    "FlockArray": {
      "Value": [
        "Cats_Wild",
        "Cats_Calico_Wild",
        "Cats_Black_Wild",
        "Cats_GrayTabby_Wild",
        "Cats_Tuxedo_Wild",
        "Cats_Siamese_Wild",
        "Cats_OrangeTabby_Wild",
        "Cats_LonghairedRussianBlue_Wild",
        "Cats_Kitten_Wild",
        "Cats_Kitten_Calico_Wild"
      ],
      "Description": "All wild cat variants that can form flocks together"
    }
  }
}
